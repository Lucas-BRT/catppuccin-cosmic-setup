# shellcheck shell=bash
# =============================================================================
# Catppuccin bash prompt (template)
# -----------------------------------------------------------------------------
# This is a template: scripts/30-bash-prompt.sh renders it with
#   lib/catppuccin.py render FLAVOR ACCENT
# which replaces each @<color>@ placeholder with that color of the chosen
# flavor as "R;G;B" (and @accent@ with the chosen accent), then installs the
# result as ~/.config/catppuccin/catppuccin-prompt.bash.
#
# It is sourced from ~/.bashrc through this block:
#   # >>> catppuccin-cosmic-setup >>>
#   [ -f ~/.config/catppuccin/catppuccin-prompt.bash ] && . ~/.config/catppuccin/catppuccin-prompt.bash
#   # <<< catppuccin-cosmic-setup <<<
#
# Uses truecolor (24-bit, "\e[38;2;R;G;Bm"), which COSMIC Terminal supports.
# Official palette: https://catppuccin.com/palette
#
# Result:  user@host ~/path main ❯
#          (blue)(overlay0)(teal) (yellow) (accent) (green)
# =============================================================================

# Interactive shells only.
[[ $- == *i* ]] || return 0

# Colors used by the prompt (R;G;B), filled in at install time.
__ctp_blue='@blue@'           # user
__ctp_overlay0='@overlay0@'   # "@"
__ctp_teal='@teal@'           # host
__ctp_yellow='@yellow@'       # working directory
__ctp_accent='@accent@'       # git branch (theme accent)
__ctp_green='@green@'         # prompt symbol

# Color escape for use inside PS1. \[ \] tells readline these bytes take no
# space on screen; without it, line wrapping gets garbled.
__ctp() { printf '\\[\\e[38;2;%sm\\]' "$1"; }

# Current git branch, or nothing outside a repository.
# \001 and \002 do the job of \[ \] here, because this text comes from a
# function run at every prompt rather than from the literal PS1.
__ctp_git() {
    local b
    b=$(git symbolic-ref --short HEAD 2>/dev/null) || return 0
    printf ' \001\e[38;2;%sm\002%s' "$__ctp_accent" "$b"
}

PS1="$(__ctp "$__ctp_blue")\u$(__ctp "$__ctp_overlay0")@$(__ctp "$__ctp_teal")\h $(__ctp "$__ctp_yellow")\w\$(__ctp_git) $(__ctp "$__ctp_green")❯\[\e[0m\] "

# `ls` colors matched to the palette:
#   di = directories (blue), ln = symlinks (teal), ex = executables (green),
#   archives (peach).
export LS_COLORS="di=38;2;@blue@:ln=38;2;@teal@:ex=38;2;@green@:*.tar=38;2;@peach@:*.zip=38;2;@peach@:*.gz=38;2;@peach@"
